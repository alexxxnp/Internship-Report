{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hugo: Start development server",
      "type": "process",
      "command": "hugo",
      "args": [
        "server",
        "--port",
        "3000",
        "--bind",
        "127.0.0.1",
        "--navigateToChanged"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}